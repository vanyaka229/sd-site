# Переменные окружения приёмника заявок.
# Установка: sudo install -m 600 -o root -g sdtg env.example /etc/sd-studio/tg-receiver.env
# В репозиторий копию с настоящим токеном НЕ кладём.

# Токен бота от @BotFather. Тот же, что в js/main.js сайта (@sddance_journal_bot).
TG_BOT_TOKEN=вставьте_токен_бота

# Кому присылать заявки. Можно несколько через запятую: '8653239953,123456789'.
# 8653239953 — @sd_dancestudio, этот id уже публично указан в js/main.js сайта.
TG_CHAT_ID=8653239953

# Порт и адрес: слушаем только localhost, наружу смотрит nginx.
PORT=8787
HOST=127.0.0.1

# Кто может отправлять заявки (белый список Origin).
ALLOWED_ORIGINS=https://sd-dance-st.ru,https://www.sd-dance-st.ru,http://localhost

# Защита от флуда: не больше 10 заявок с одного IP в минуту,
# повторная заявка с тем же телефоном — не чаще раза в 30 секунд.
RATE_LIMIT_PER_MIN=10
DEDUP_SECONDS=30

# Таймаут обращения к Telegram, мс.
TG_TIMEOUT=10000

# Только для автотестов: подмена api.telegram.org. В бою НЕ задавать.
# TG_API_BASE=http://127.0.0.1:18792
